# Example environment configuration. Copy to .env and adjust.
# NEVER commit a real .env (it is gitignored).

# --- Storage backend ---
# local (default, no credentials needed) or s3
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=data/object_store

# --- AWS S3 (only when STORAGE_BACKEND=s3) ---
# Credentials are discovered via the AWS-native provider chain
# (env vars, shared config/profile, or instance/role credentials).
# Do NOT hard-code AWS keys here in production.
S3_BUCKET=
S3_PREFIX=lakehouse
AWS_REGION=us-east-1

# --- Spark / JVM ---
JAVA_HOME=/opt/homebrew/opt/openjdk@17
SPARK_LOCAL_IP=127.0.0.1
SPARK_MASTER=local[*]

# --- Lakehouse paths (optional overrides) ---
# LAKEHOUSE_DATA_ROOT=data
# LAKEHOUSE_WAREHOUSE=data/warehouse
